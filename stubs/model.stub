/**
 * KV-backed model. Bind a namespace in wrangler.toml and adjust the binding
 * name below (defaults to a guess based on the class name).
 */
export class {{className}} {
  static binding = '{{bindingName}}';

  static key(id) {
    return `{{lowerName}}:${id}`;
  }

  static async find(env, id) {
    const raw = await env[this.binding]?.get(this.key(id));
    return raw ? JSON.parse(raw) : null;
  }

  static async save(env, id, data) {
    const existing = (await this.find(env, id)) || {};
    const merged = { ...existing, ...data, id };
    await env[this.binding]?.put(this.key(id), JSON.stringify(merged));
    return merged;
  }

  static async delete(env, id) {
    await env[this.binding]?.delete(this.key(id));
  }
}
